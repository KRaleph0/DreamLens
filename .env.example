# DB (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=dreamlens
DB_USER=dreamlens
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_min_32chars  # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI
RUNPOD_API_KEY=your_runpod_api_key

# App
SECRET_KEY=your_secret_key
CLOUDFLARE_TOKEN=your_cloudflare_token
ALLOWED_ORIGINS=https://www.dreamlens.cc